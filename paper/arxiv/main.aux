\@writefile{toc}{\contentsline {section}{\numberline {VII}Novelty Assessment and Claim Ladder}{5}{section.7}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Field-study dashboard over the census window} (five machines, 2026-10-22 to 2026-11-02). \textbf  {(a)} Daily structured-message volume by performative class (\(n=283\)); mean 26/day over active days, peak 49 on Oct 30; the pause day saw no posts. \textbf  {(b)} Speech-act mix: 37 data deliveries, 29 asks, 89 ack/reply discharges, 120 notes, and 8 governance posts. \textbf  {(c)} Producers by machine; the fifth machine ran offline and was served by a relay courier. \textbf  {(d)} Message block sizes (\(n=265\) parsed blocks, log scale): coordination acts cost hundreds of bytes of context, while payload bytes move out-of-band. \textbf  {(e)} Arrival-hour profile: 31 turns occurred in the 00:00-07:00 night window under turn-driven watchkeeping. \textbf  {(f)} Coverage across the ten dimensions of Section 7 for the five nearest public systems (filled circle = full, half circle = partial, dash = absent); scores are dimension sums.}}{6}{figure.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {Controlled ablation, A0 single-session vs.\ A1 room-federated} (same-window Latin square, $n=3$; zero interventions, zero fallback). \textbf  {(a)} E1: makespan per round; A1 is lower in every round (means 141.7 vs.\ 215.0~s, $1.52\times $ / 34\% faster, 3$\times $ lower variance). \textbf  {(b)} E2: per-task latency (mean of $n=3$); A1 includes room-acknowledgment queueing. \textbf  {(c)} E3: context bytes read per task by class; A1's pointer reads (1,439~B/task) exceed its payload saving at this $\approx $2~KB payload scale, so H2 (context economy) is unsupported at small payloads. \textbf  {(d)} E4: turns per round with room-message counts; the federation pays $+1.3$ turns and 57 room messages (H3, coordination overhead, supported). Verification parity: first pass 18/18 per arm (H4). No significance test is claimed at $n=3$.}}{7}{figure.3}\protected@file@percent }
