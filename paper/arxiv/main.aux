\newlabel{message-calculus}{{\mbox  {IV-}1}{2}{4.1 Message calculus}{subsubsection.4.0.1}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {\mbox  {IV-}1}4.1 Message calculus}{2}{subsubsection.4.0.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Figure 1.} Murmuration at a glance. (a) Heterogeneous nodes coordinate through one shared plain-text store --- public log, per-machine inboxes, per-role cursors --- under a versioned governance handbook and time-triggered watchkeeping; payloads never enter the store and move over pre-existing point-to-point channels. (b) Pointer-delivery lifecycle: manifests and digests travel as text inside the context budget; files are fetched out-of-band and verified shell-side.}}{3}{figure.1}\protected@file@percent }
